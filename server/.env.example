# Keep server/.env private; never commit or share actual credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/mechanic_shop
PORT=3001
# Local development uses 127.0.0.1 unless HOST is set. Production defaults to
# 0.0.0.0; the hosting platform supplies its PORT. Set NODE_ENV in host settings.
# NODE_ENV=development
# HOST=127.0.0.1
# Set true only after npm run build to serve the website and API together.
SERVE_FRONTEND=false
# Bounded HTTP/mail drain before database disconnect during a host restart.
SHUTDOWN_GRACE_MS=10000
# Leave false until the actual trusted proxy IPs/CIDRs are confirmed. Do not
# use true or a guessed hop count. See docs/production-launch.md.
TRUST_PROXY=false
MECHANIC_ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_LONG_RANDOM_PASSWORD

# Phase 4: SMTP email provider credentials. Leave unset until you have a TEST account.
# All six fields are required to turn on outgoing email.
# SMTP_PORT 465 uses TLS; port 587 requires STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MECHANIC_NOTIFICATION_EMAIL=

# Customer management stays unavailable until origin, random secret, and all
# SMTP fields above are configured. Never commit a real key. See documentation.
PUBLIC_WEBSITE_ORIGIN=
APPOINTMENT_MANAGEMENT_SECRET=

# Protected Render preview only; don't enable on the normal development DB.
# See docs/render-staging.md. Staging forces all outgoing mail off, regardless
# of SMTP fields. Supply an explicit matching eds_staging_* URI/database and
# a separate private random gateway password (32+ characters).
# DEPLOYMENT_STAGE=staging
# STAGING_ACCESS_PASSWORD=
# MONGODB_DATABASE=eds_staging_preview
# Public booking quota is optional for existing development, on in the staging
# template. Counters are process-local; verify real proxy/client-IP handling.
BOOKING_RATE_LIMIT_ENABLED=false
# BOOKING_RATE_LIMIT_MAX=5
# BOOKING_RATE_LIMIT_WINDOW_MINUTES=15
