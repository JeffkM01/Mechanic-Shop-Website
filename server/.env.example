# Keep server/.env private; never commit or share actual credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/mechanic_shop
PORT=3001
MECHANIC_ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_LONG_RANDOM_PASSWORD

# Phase 4: SMTP email provider credentials. Leave unset until you have a TEST account.
# All six fields are required to turn on outgoing email.
# SMTP_PORT 465 uses TLS; port 587 requires STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MECHANIC_NOTIFICATION_EMAIL=

# Customer management stays unavailable until origin, random secret, and all
# SMTP fields above are configured. Never commit a real key. See documentation.
PUBLIC_WEBSITE_ORIGIN=
APPOINTMENT_MANAGEMENT_SECRET=
